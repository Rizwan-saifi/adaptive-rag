# Port the BFF listens on (Streamlit expects 8080)
PORT=8080
# Interface to listen on (use 0.0.0.0 inside a container)
HOST=127.0.0.1
# Secret used to sign JWTs - change this
JWT_SECRET=change_me_to_a_long_random_string
# JWT lifetime in seconds
JWT_EXPIRES_IN=86400
# API token (from /api/init) lifetime in seconds
API_TOKEN_EXPIRES_IN=86400
# SQLite file holding users (the Rust BFF users.db is compatible)
DB_PATH=users.db
# Python Adaptive-RAG service
PYTHON_RAG_URL=http://127.0.0.1:8000/rag/query
# Seconds to wait for the RAG service to answer
RAG_TIMEOUT=300
